# Porta em que a API vai rodar
PORT=3000

# Banco de dados (SQLite por padrão - simples de rodar sem instalar nada)
# Para Postgres, use algo como: postgresql://user:password@localhost:5432/helpdesk
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar os tokens JWT (troque em produção)
JWT_SECRET="troque_pela_chave_token"
JWT_EXPIRES_IN="1d"

# Chave opcional para uma API de IA gratuita (ex.: Hugging Face Inference API).
# Se não for preenchida, o sistema usa automaticamente o fallback heurístico
# baseado em palavras-chave (ver TRIAGEM_PROVIDER abaixo e o README).
HUGGINGFACE_API_KEY="Insira aqui a chave da API"

# Estratégia de triagem: "heuristic" (padrão, não precisa de chave) ou "huggingface"
TRIAGEM_PROVIDER=heuristic
